#VRML V2.0 utf8
# WS2812B-2020 Addressable RGB Micro-LED (2.0mm x 2.0mm x 0.65mm)
# Origin (0,0,0) is centered on the package

Group {
  children [
    # 1. White Molded Plastic / Ceramic Package Body (2.0 x 2.0 x 0.65 mm)
    Transform {
      translation 0 0 0.325
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.92 0.92 0.92  # Clean high-temp matte white plastic
              specularColor 0.2 0.2 0.2
              shininess 0.3
            }
          }
          geometry Box {
            size 2.0 2.0 0.65
          }
        }
      ]
    }

    # 2. Recessed Optical Cavity / Reflector Cup (1.3 x 1.3 x 0.2 mm)
    Transform {
      translation 0 0 0.56
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.1 0.1 0.12   # Dark recessed cavity background
              specularColor 0.4 0.4 0.4
              shininess 0.6
            }
          }
          geometry Box {
            size 1.3 1.3 0.2
          }
        }
      ]
    }

    # 3. Transparent Silicone / Epoxy Lens (1.28 x 1.28 x 0.15 mm)
    Transform {
      translation 0 0 0.60
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.05 0.15 0.25
              emissiveColor 0.08 0.18 0.28 # Subtle idle crystal glow
              specularColor 0.9 0.9 1.0
              shininess 0.9
              transparency 0.25
            }
          }
          geometry Box {
            size 1.28 1.28 0.12
          }
        }
      ]
    }

    # 4. Silicon IC Controller Die (0.5 x 0.4 x 0.1 mm inside cavity)
    Transform {
      translation 0.25 -0.25 0.52
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.2 0.2 0.22  # Silicon microchip die
              specularColor 0.8 0.8 0.8
              shininess 0.8
            }
          }
          geometry Box {
            size 0.5 0.4 0.08
          }
        }
      ]
    }

    # 5. Micro LED Emitters (RGB micro dies)
    # Red die
    Transform {
      translation -0.3 0.25 0.52
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.8 0.1 0.1
              emissiveColor 0.6 0.05 0.05
              shininess 0.9
            }
          }
          geometry Box {
            size 0.25 0.25 0.08
          }
        }
      ]
    }
    # Green die
    Transform {
      translation 0.05 0.25 0.52
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.1 0.8 0.2
              emissiveColor 0.05 0.6 0.1
              shininess 0.9
            }
          }
          geometry Box {
            size 0.25 0.25 0.08
          }
        }
      ]
    }
    # Blue die
    Transform {
      translation -0.3 -0.15 0.52
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.1 0.3 0.9
              emissiveColor 0.05 0.2 0.7
              shininess 0.9
            }
          }
          geometry Box {
            size 0.25 0.25 0.08
          }
        }
      ]
    }

    # 6. Pin 1 Index Chamfer / Dot (top left corner)
    Transform {
      translation -0.7 -0.7 0.655
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.3 0.5 0.8
              shininess 0.5
            }
          }
          geometry Cylinder {
            radius 0.12
            height 0.02
          }
        }
      ]
    }

    # 7. 4 ENIG Gold Solder Pads on bottom (-0.915, -0.55), (-0.915, 0.55), (0.915, 0.55), (0.915, -0.55)
    Transform {
      translation -0.915 -0.55 0.02
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.85 0.75 0.25  # Gold
              specularColor 0.9 0.9 0.5
              shininess 0.9
            }
          }
          geometry Box {
            size 0.7 0.7 0.05
          }
        }
      ]
    }
    Transform {
      translation -0.915 0.55 0.02
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.85 0.75 0.25
              specularColor 0.9 0.9 0.5
              shininess 0.9
            }
          }
          geometry Box {
            size 0.7 0.7 0.05
          }
        }
      ]
    }
    Transform {
      translation 0.915 0.55 0.02
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.85 0.75 0.25
              specularColor 0.9 0.9 0.5
              shininess 0.9
            }
          }
          geometry Box {
            size 0.7 0.7 0.05
          }
        }
      ]
    }
    Transform {
      translation 0.915 -0.55 0.02
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.85 0.75 0.25
              specularColor 0.9 0.9 0.5
              shininess 0.9
            }
          }
          geometry Box {
            size 0.7 0.7 0.05
          }
        }
      ]
    }
  ]
}